{$FAI_DOMAIN} {
	# Calendar clients cannot complete an interactive login; the feed is gated
	# by its own URL token instead.
	handle /api/calendar.ics* {
		reverse_proxy backend:8080
	}

	handle {
		basic_auth {
			{$FAI_AUTH_USER} {$FAI_AUTH_HASH}
		}

		handle /api/* {
			reverse_proxy backend:8080 {
				header_up X-Forwarded-User {http.auth.user.id}
			}
		}
		handle {
			reverse_proxy frontend:80
		}
	}
}
