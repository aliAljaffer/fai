# Copy to .env for docker-compose.prod.yml. Only the first two values are required.

# Public hostname with DNS pointing at this server. Caddy gets the TLS certificate.
FAI_DOMAIN=fai.example.com
# HTTP Basic auth for the whole site. Caddy hashes this at container start.
FAI_AUTH_PASSWORD=change-me

# Optional. Basic auth user name. Defaults to admin.
FAI_AUTH_USER=admin

# Optional. Calendar feed token (openssl rand -hex 32). The feed is off when empty.
ICS_TOKEN=

# Optional integrations. All stay hidden or disabled when unset.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_DEFAULT_PROJECT_KEY=
JIRA_STATUS_COLUMN_MAP=
JIRA_EPIC_ISSUE_TYPE=Epic
JIRA_TASK_ISSUE_TYPE=Task
JIRA_SUBTASK_ISSUE_TYPE=Sub-task
JIRA_EPIC_LINK_FIELD=parent
NTFY_TOPIC=fai-reminders
NTFY_USERNAME=
NTFY_PASSWORD=
# Optional email channel (any SMTP relay; no auth is used).
SMTP_ADDR=
SMTP_FROM=
SMTP_TO=
AI_PROVIDER=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_FALLBACK_PROVIDER=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
# Optional. OpenAI-compatible speech-to-text for Telegram voice notes.
STT_BASE_URL=
STT_MODEL=whisper-1
STT_API_KEY=
STT_LANGUAGE=
# Optional. ElevenLabs speech-to-text when STT_BASE_URL is unset.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_ALLOWED_CHAT_ID=
# Minutes east of UTC for relative dates. Riyadh is 180.
TELEGRAM_TZ_OFFSET=0
REMINDER_CHANNEL=
