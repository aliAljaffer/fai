# Copy to .env.prod and fill in. Used by docker-compose.prod.yml.

# Public domain Caddy serves and gets a TLS cert for (real DNS must point here).
FAI_DOMAIN=fai.yourdomain.com
PUBLIC_URL=https://fai.yourdomain.com

# Read-only calendar feed credential (openssl rand -hex 32). Also shown in Settings.
ICS_TOKEN=

# oauth2-proxy: register a confidential OIDC client (standard flow, NOT public/PKCE —
# oauth2-proxy runs server-side and can hold a secret) against your Keycloak or other
# OIDC provider. Redirect URI: https://<FAI_DOMAIN>/oauth2/callback
OAUTH2_PROXY_OIDC_ISSUER_URL=
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# Generate with: openssl rand -base64 32
OAUTH2_PROXY_COOKIE_SECRET=

# Optional integrations — all degrade gracefully (feature hidden/disabled) when unset.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_DEFAULT_PROJECT_KEY=
JIRA_STATUS_COLUMN_MAP=
NTFY_TOPIC=fai-reminders
NTFY_USERNAME=
NTFY_PASSWORD=
# Optional email channel (any SMTP relay; no auth is used).
SMTP_ADDR=
SMTP_FROM=
SMTP_TO=
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
