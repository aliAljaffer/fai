# Copy to .env.prod and fill in. Used by docker-compose.prod.yml.

# Public domain Caddy serves and gets a TLS cert for (real DNS must point here).
FAI_DOMAIN=fai.yourdomain.com
PUBLIC_URL=https://fai.yourdomain.com

# Read-only calendar feed credential (openssl rand -hex 32). Also shown in Settings.
ICS_TOKEN=

# HTTP Basic auth for the whole site, enforced by Caddy. Run `make hash-password`
# and paste its output below; it is already $$-escaped for Compose env files.
FAI_AUTH_USER=admin
FAI_AUTH_HASH=

# Optional integrations — all degrade gracefully (feature hidden/disabled) when unset.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_DEFAULT_PROJECT_KEY=
JIRA_STATUS_COLUMN_MAP=
JIRA_EPIC_ISSUE_TYPE=Epic
JIRA_SUBTASK_ISSUE_TYPE=Sub-task
NTFY_TOPIC=fai-reminders
NTFY_USERNAME=
NTFY_PASSWORD=
# Optional email channel (any SMTP relay; no auth is used).
SMTP_ADDR=
SMTP_FROM=
SMTP_TO=
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
